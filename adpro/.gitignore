# Built by scripts/inline-preview.mjs from dist/ — the whole home page folded
# into one file, photographs and all, for sharing a work-in-progress state
# without deploying it. Derived output, and several megabytes of it.
preview.html

# Generated by scripts/generate-listing-pages.mjs on every build — one entry
# file per billboard and per city, derived from src/data/boards.json.
# ... which land in pages/ in the standalone repo and at the project root
# here, so both shapes are covered.
pages/led-*.html
pages/billboards-*.html
led-*.html
billboards-*.html
faq-*.html
news-*.html
!billboards.html
!faq.html
!news.html
