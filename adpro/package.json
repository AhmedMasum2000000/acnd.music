{
  "name": "adpro-communications",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AD PRO Communications Limited — outdoor advertising agency site, Dhaka, Bangladesh.",
  "scripts": {
    "dev": "npm run prebuild && vite",
    "prebuild": "node scripts/generate-listing-pages.mjs",
    "build": "npm run prebuild && tsc -b && vite build",
    "build:pages": "BASE_PATH=/ad-pro/ npm run build && node scripts/publish-root.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@barba/core": "^2.10.3",
    "@fontsource-variable/fraunces": "^5.3.0",
    "gsap": "^3.13.0",
    "lenis": "^1.1.18"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.1.1",
    "@fontsource/bebas-neue": "^5.1.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@types/node": "^26.1.1",
    "playwright": "^1.62.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
