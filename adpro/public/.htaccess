# Server configuration for Hostinger (Apache / LiteSpeed).
#
# GitHub Pages handled compression, caching and HTTPS on its own. A shared
# host does not, so the things that were free before have to be asked for
# here. Every directive is wrapped in an <IfModule> so a missing module
# degrades the site rather than returning a 500.

# --- HTTPS and canonical host ------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS. Hostinger terminates TLS upstream, so the scheme arrives in
  # X-Forwarded-Proto rather than in HTTPS on some plans; both are checked.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # One canonical host. Duplicate content on www and apex splits the ranking
  # signal between two addresses that are the same site.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # Allow /billboards as well as /billboards.html, so a tidier URL works if
  # anyone links one. The .html remains canonical — every internal link and
  # every <link rel="canonical"> uses it — so this adds reach without
  # creating a second address for the same page in search.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+?)/?$ /$1.html [L]
</IfModule>

# --- Compression -------------------------------------------------------------
# The HTML is 20-90kB a page before compression and roughly a fifth of that
# after, which on a mobile connection in Dhaka is the single biggest win
# available here.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE application/rss+xml image/svg+xml
  AddOutputFilterByType DEFLATE font/woff font/woff2 application/font-woff
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/xml
  AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json
  AddOutputFilterByType BROTLI_COMPRESS image/svg+xml font/woff2
</IfModule>

# --- Caching -----------------------------------------------------------------
# Assets carry a content hash in their filename, so they can be cached for a
# year: a change produces a new filename rather than a stale file. HTML must
# not be, or a visitor keeps yesterday's page.
<IfModule mod_expires.c>
  ExpiresActive On

  ExpiresByType text/html                     "access plus 0 seconds"
  ExpiresByType application/xml               "access plus 1 hour"
  ExpiresByType text/plain                    "access plus 1 day"

  ExpiresByType text/css                      "access plus 1 year"
  ExpiresByType application/javascript        "access plus 1 year"
  ExpiresByType font/woff2                    "access plus 1 year"
  ExpiresByType font/woff                     "access plus 1 year"

  ExpiresByType image/jpeg                    "access plus 6 months"
  ExpiresByType image/png                     "access plus 6 months"
  ExpiresByType image/svg+xml                 "access plus 6 months"
  ExpiresByType image/webp                    "access plus 6 months"
</IfModule>

<IfModule mod_headers.c>
  # Hashed assets are immutable by construction.
  <FilesMatch "\.(css|js|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML is revalidated every time, so a deploy is visible immediately.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # --- Security headers ---
  # Modest and safe for a static marketing site. No CSP: the pages carry
  # inline `style` attributes for per-slide focal points, and a policy loose
  # enough to allow those would not be buying much.
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

  # The deploy marker is operational metadata, not content.
  <Files ".adpro-deploy">
    Header set X-Robots-Tag "noindex"
  </Files>
</IfModule>

# --- Character set and MIME --------------------------------------------------
AddDefaultCharset UTF-8

<IfModule mod_mime.c>
  AddType application/xml .xml
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
</IfModule>

# --- Errors ------------------------------------------------------------------
ErrorDocument 404 /404.html

# --- Keep operational files out of the browser -------------------------------
<FilesMatch "^\.(env|git|adpro-deploy)">
  Require all denied
</FilesMatch>

<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>
